# Copy to .env on the VM:  cp .env.example .env && nano .env
# Never commit the real .env file.

DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_64

# Public ports on the VM
FRONTEND_PORT=8080
BACKEND_PORT=8081

# Bind MySQL to localhost only (recommended)
MYSQL_PUBLISH_PORT=127.0.0.1:3307

# HTTP on the VM → leave secure=false. After you add HTTPS, set true + SameSite=None if needed.
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax

# Add your VM public URL so browser CORS works if anything still hits :8081 directly.
# Example: http://YOUR_VM_IP:8080,http://YOUR_VM_IP:8081,http://localhost:*
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# GHCR image coordinates (lowercase)
BACKEND_IMAGE=induwara90/event-management-uni-ruhuna
FRONTEND_IMAGE=induwara90/event-management-frontend
IMAGE_TAG=latest
